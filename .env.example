# ---------- Next.js app (.env.local) ----------
# Clerk: https://dashboard.clerk.com -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Created by `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ---------- Convex (set with `npx convex env set NAME value`, NOT in a file) ----------
# CLERK_JWT_ISSUER_DOMAIN   Clerk -> JWT templates -> "convex" -> Issuer
# N8N_WEBHOOK_URL           e.g. http://localhost:5678/webhook/lendloop-request-events
#                           (use a public tunnel/URL when Convex runs in the cloud)
# N8N_WEBHOOK_SECRET        long random string, same value as in n8n (see below)

# ---------- n8n / docker compose (.env next to docker-compose.yml) ----------
# Same secret as Convex. Generate with: openssl rand -hex 32
LENDLOOP_SHARED_SECRET=change-me
# Convex HTTP actions URL (ends with .convex.site)
CONVEX_SITE_URL=https://your-deployment.convex.site
# Key used by n8n to encrypt credentials stored in its database
# (the editor itself is protected by the owner account you create on first start)
N8N_ENCRYPTION_KEY=change-me-too
